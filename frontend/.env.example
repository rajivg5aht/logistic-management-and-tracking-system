# Public URL for your deployed Express API (no trailing slash).
NEXT_PUBLIC_API_URL=https://api.example.com

# Public URL for Socket.IO. Use the same API URL unless your socket server is separate.
NEXT_PUBLIC_SOCKET_URL=https://api.example.com

# Server-side origin used by Next.js rewrites for /api/v1 and /uploads.
# Use the API's internal URL when your host provides one; otherwise use its public URL.
BACKEND_INTERNAL_URL=https://api.example.com

# Do not add backend secrets, database credentials, or JWT secrets to this frontend file.
